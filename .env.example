# Copy this file to .env and add your real key. Do not commit .env.
OPENAI_API_KEY=

# Select either "openai" or "local".
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Per-request timeout in seconds, and retries after a failed request.
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# Local mode only
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
