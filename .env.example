# Copy this file to .env and add your real key. Do not commit .env.
OPENAI_API_KEY=

# Select either "openai" or "local".
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Per-request timeout in seconds, and retries after a failed request.
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# Conversation memory (in-process): seconds a thread may sit unused before it
# is deleted, and how many threads are kept before the oldest are deleted.
THREAD_TTL=3600
MAX_THREADS=1000

# Workspace boundary and project context.
# Defaults to the directory the server starts in; set it to the project root.
# WORKSPACE_ROOT=/path/to/project
# Extra case-insensitive glob patterns; .env*, .git, and .claude are always
# denied.
# Without a "/" a pattern matches names at any depth; with one, it's relative
# to the workspace root.
WORKSPACE_DENIED_PATHS=[]
WORKSPACE_CONTEXT_MAX_CHARS=20000

# Agent loop: graph steps per request (each tool round takes two), its normal
# between-steps deadline, and the additional last-resort cancellation window.
AGENT_MAX_STEPS=25
AGENT_RUN_TIMEOUT=300
AGENT_RUN_BACKSTOP_TIMEOUT=60

# Developer test page at /ui/ and GET /threads/{thread_id}/messages.
# Off by default: there's no authentication yet, so keep the server on
# 127.0.0.1 while it's on.
# DEV_UI_ENABLED=true

# Command sandbox (see docs/sandbox.md). auto picks Seatbelt on macOS or
# bubblewrap on Linux; off disables command tools. There is no unsandboxed
# setting.
SANDBOX_BACKEND=auto
SANDBOX_COMMAND_TIMEOUT=120
SANDBOX_MAX_OUTPUT_BYTES=51200
# Read-only paths for toolchains under your home directory, for example:
# SANDBOX_READ_PATHS=["~/.local/share/uv/python", "~/.pyenv"]
# SANDBOX_PATH=/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin
# SANDBOX_ENV={"PYTHONDONTWRITEBYTECODE": "1"}

# Local mode only
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
